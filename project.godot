; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NOXSUM"
run/main_scene="res://scenes/campaign.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.075, 0.078, 0.09, 1)
boot_splash/image="res://assets/nox/v0.6/app_icon.png"
config/icon="res://assets/nox/v0.6/app_icon.png"

[autoload]

BgmPlaylist="*res://src/ui/bgm_playlist.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=900
window/size/window_width_override=720
window/size/window_height_override=900
window/stretch/aspect="expand"

[gui]

theme/custom="res://theme/product_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
